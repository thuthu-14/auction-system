<?xml version="1.0" encoding="utf-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.ImageView?>
<VBox xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx"
      fx:controller="client.controller.SellerAuctionDetailsController" spacing="35" fillWidth="true"
      style="-fx-background-color: #fcfcfc; -fx-padding: 40 60 40 60;">
    <Label text="Chi tiết phiên đấu giá" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
    <HBox style="-fx-background-color: #edf2f7; -fx-background-radius: 12; -fx-padding: 6;" spacing="10"
          alignment="CENTER_LEFT" maxWidth="Infinity">
        <Button text="Thông tin" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: white; -fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 10 30; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 5, 0, 0, 1); -fx-cursor: hand;"/>
        <Button text="Lịch sử đặt giá" maxWidth="Infinity" onAction="#handleBidHistory" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-text-fill: #718096; -fx-font-size: 15px; -fx-padding: 10 30; -fx-cursor: hand;"/>
        <Button text="Thông tin người trúng" maxWidth="Infinity" onAction="#handleWinnerInfo" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-text-fill: #718096; -fx-font-size: 15px; -fx-padding: 10 30; -fx-cursor: hand;"/>
    </HBox>
    <VBox VBox.vgrow="ALWAYS" spacing="30"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 35; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
        <VBox spacing="15">
            <Label text="THÔNG TIN SẢN PHẨM"
                   style="-fx-font-size: 14px; -fx-text-fill: #718096; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
            <HBox spacing="25" alignment="TOP_LEFT" fillHeight="false">
                <StackPane minWidth="150" minHeight="150" prefWidth="150" prefHeight="150" maxWidth="150"
                           maxHeight="150"
                           style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                    <ImageView fx:id="productImage" fitWidth="130" fitHeight="130" preserveRatio="true"/>
                </StackPane>
                <VBox spacing="10">
                    <Label fx:id="productName" text="Đang tải tên sản phẩm..."
                           style="-fx-font-size: 24px; -fx-text-fill: #111827; -fx-font-weight: bold;"/>
                    <Label fx:id="productId" text="Mã phiên: #AU-2024-001"
                           style="-fx-font-size: 16px; -fx-text-fill: #718096;"/>
                    <Label fx:id="productDesc" text="Mô tả chi tiết sản phẩm..."
                           style="-fx-font-size: 16px; -fx-text-fill: #4a5568;" wrapText="true" maxWidth="800"/>
                </VBox>
            </HBox>
        </VBox>
        <Separator style="-fx-opacity: 0.5;"/>
        <GridPane hgap="100" vgap="30">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="300"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="300"/>
            </columnConstraints>
            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Giá khởi điểm" style="-fx-font-size: 15px; -fx-text-fill: #718096;"/>
                <Label fx:id="startPrice" text="1,000,000 đ"
                       style="-fx-font-size: 20px; -fx-text-fill: #111827; -fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Giá hiện tại" style="-fx-font-size: 15px; -fx-text-fill: #718096;"/>
                <Label fx:id="currentPrice" text="190.000đ"
                       style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #dc2626;"/>
            </VBox>
            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Thời gian bắt đầu" style="-fx-font-size: 15px; -fx-text-fill: #718096;"/>
                <Label fx:id="startTime" text="20/05/2024 - 08:00"
                       style="-fx-font-size: 18px; -fx-text-fill: #111827;"/>
            </VBox>
            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Thời gian kết thúc" style="-fx-font-size: 15px; -fx-text-fill: #718096;"/>
                <Label fx:id="endTime" text="22/05/2024 - 18:00" style="-fx-font-size: 18px; -fx-text-fill: #111827;"/>
            </VBox>
            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label text="Trạng thái phiên" style="-fx-font-size: 15px; -fx-text-fill: #718096;"/>
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="status" text="ĐANG DIỄN RA"
                           style="-fx-background-color: #dcfce7; -fx-text-fill: #166534; -fx-padding: 6 16; -fx-background-radius: 20; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                </HBox>
            </VBox>
            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label text="Số lượng đặt giá" style="-fx-font-size: 15px; -fx-text-fill: #718096;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="bidCount" text="25"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Label text="lượt đặt" style="-fx-font-size: 16px; -fx-text-fill: #718096;"/>
                </HBox>
            </VBox>
            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                <Label text="Thời gian còn lại" style="-fx-font-size: 15px; -fx-text-fill: #718096;"/>
                <Label fx:id="timeLeft" text="01 ngày 04 giờ 20 phút 15 giây"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
            </VBox>
        </GridPane>
        <Region VBox.vgrow="ALWAYS"/>
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <Button fx:id="cancelAuctionButton" text="Hủy phiên" onAction="#handleCancel"
                    style="-fx-background-color: white; -fx-text-fill: #dc2626; -fx-font-size: 15px; -fx-padding: 12 30; -fx-border-color: #fca5a5; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</VBox>
