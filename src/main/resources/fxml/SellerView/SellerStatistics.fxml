<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToWidth="true"
            hbarPolicy="NEVER"
            style="-fx-background-color: #fcfcfc; -fx-background: #fcfcfc;"
            stylesheets="@../../CSS/style.css"
            vbarPolicy="NEVER"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controller.SellerStatisticsController">
    <VBox spacing="30.0" style="-fx-background-color: #fcfcfc;">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <HBox alignment="CENTER_LEFT">
            <VBox spacing="5.0">
                <Label text="Phân tích kinh doanh" textFill="#111827">
                    <font><Font name="System Bold" size="28.0" /></font>
                </Label>
                <Label text="Theo dõi doanh thu và hiệu suất bán hàng của bạn" textFill="#4b5563">
                    <font><Font size="14.0" /></font>
                </Label>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <GridPane hgap="20.0" vgap="20.0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <children>
                <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-border-color: #edf2f7; -fx-border-radius: 16;" GridPane.columnIndex="0">
                    <Label text="Tổng doanh thu" textFill="#4b5563"><font><Font size="14.0" /></font></Label>
                    <Label fx:id="totalRevenueLabel" text="0 đ" textFill="#111827"><font><Font name="System Bold" size="26.0" /></font><VBox.margin><Insets top="10.0" /></VBox.margin></Label>
                </VBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-border-color: #edf2f7; -fx-border-radius: 16;" GridPane.columnIndex="1">
                    <Label text="Số lượt đặt trung bình" textFill="#4b5563"><font><Font size="14.0" /></font></Label>
                    <Label fx:id="avgBidLabel" text="0.0" textFill="#111827"><font><Font name="System Bold" size="26.0" /></font><VBox.margin><Insets top="10.0" /></VBox.margin></Label>
                </VBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-border-color: #edf2f7; -fx-border-radius: 16;" GridPane.columnIndex="2">
                    <Label text="Tỷ lệ chốt thành công" textFill="#4b5563"><font><Font size="14.0" /></font></Label>
                    <Label fx:id="successRateLabel" text="0.0%" textFill="#111827"><font><Font name="System Bold" size="26.0" /></font><VBox.margin><Insets top="10.0" /></VBox.margin></Label>
                </VBox>
            </children>
            <rowConstraints>
                <RowConstraints />
            </rowConstraints>
        </GridPane>

        <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-border-color: #edf2f7; -fx-border-radius: 16;">
            <Label text="Tăng trưởng doanh thu" textFill="#111827">
                <font><Font name="System Bold" size="18.0" /></font>
                <VBox.margin><Insets bottom="20.0" /></VBox.margin>
            </Label>
            <LineChart fx:id="revenueChart" createSymbols="true" legendVisible="false" prefHeight="350.0" styleClass="seller-revenue-chart">
                <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                <yAxis><NumberAxis side="LEFT" /></yAxis>
            </LineChart>
        </VBox>
    </VBox>
</ScrollPane>
