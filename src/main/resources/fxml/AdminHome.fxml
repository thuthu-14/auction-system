<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="rootPane" minHeight="600.0" minWidth="900.0" prefHeight="900.0" prefWidth="1440.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.AdminHomeController">

    <children>

        <HBox style="-fx-background-color: #ffffff;">
            <children>

                <VBox maxWidth="230.0" minWidth="230.0" prefWidth="230.0" spacing="5.0" style="-fx-background-color: #ffffff; -fx-border-color: #f0f0f0; -fx-border-width: 0 1 0 0; -fx-padding: 20 15 20 15;">
                    <children>

                        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="5.0">
                            <children>
                                <ImageView fitHeight="60.0" fitWidth="65.0" pickOnBounds="true" preserveRatio="true" smooth="true">
                                    <image>
                                        <Image url="@../CSS/logo.png" />
                                    </image>
                                </ImageView>

                                <Label styleClass="my-darley" text="BubblyBid" textFill="#1a1a1a">
                                    <font>
                                        <Font name="Darley Sans" size="27.0" />
                                    </font>
                                </Label>
                            </children>
                            <VBox.margin>
                                <Insets bottom="30.0" left="0.0" top="-10.0" />
                            </VBox.margin>
                        </HBox>

                        <Label text="QUẢN TRỊ HỆ THỐNG" textFill="#a0aec0">
                            <font>
                                <Font size="15.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="5.0" left="20.0" />
                            </VBox.margin>
                        </Label>

                        <HBox fx:id="menuRecent" alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#handleMenuClick" prefHeight="45.0" prefWidth="230.0" style="-fx-background-radius: 8; -fx-cursor: hand;">
                            <children>
                                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onMouseClicked="#loadUserManagementView" style="-fx-background-color: transparent;" text="👥  Quản lý User" textFill="#4a5568" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font size="17.0" />
                                    </font>
                                    <padding>
                                        <Insets left="20.0" /> </padding>
                                </Button>
                            </children>
                        </HBox>

                        <HBox fx:id="menuMsg" alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#handleMenuClick" prefHeight="45.0" prefWidth="230.0" style="-fx-background-radius: 8; -fx-cursor: hand;">
                            <children>
                                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onMouseClicked="#loadAuctionManagementView" style="-fx-background-color: transparent;" text="⚖  Quản lý Phiên đấu" textFill="#4a5568" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font size="17.0" />
                                    </font>
                                    <padding>
                                        <Insets left="20.0" /> </padding>
                                </Button>
                            </children>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <HBox fx:id="menuUpgrade" alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#handleMenuClick" prefHeight="45.0" prefWidth="230.0" style="-fx-background-radius: 8; -fx-cursor: hand;">
                            <children>
                                <Button alignment="BASELINE_LEFT" onMouseClicked="#loadLogOutView" maxWidth="Infinity" style="-fx-background-color: transparent;" text="🚪  Đăng xuất" textFill="#e53e3e" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                    <padding>
                                        <Insets left="18.0" /> </padding>
                                </Button>
                            </children>
                        </HBox>

                    </children>
                </VBox>

                <VBox HBox.hgrow="ALWAYS">
                    <children>

                        <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: #ffffff; -fx-padding: 0 40 0 40; -fx-border-color: #f0f0f0; -fx-border-width: 0 0 1 0;">
                            <children>

                                <Region HBox.hgrow="ALWAYS" />

                                <Button style="-fx-background-color: transparent; -fx-cursor: hand;" text="🌙">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Button>

                                <Button prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #e2e8f0; -fx-background-radius: 20; -fx-cursor: hand;" text="👤">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets left="20.0" />
                                    </HBox.margin>
                                </Button>

                            </children>
                        </HBox>

                        <StackPane fx:id="contentArea" style="-fx-background-color: #fcfcfc;" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <Label style="-fx-translate-x: -3;" text="Bảng điều khiển Admin" textFill="#2e384d">
                                            <font>
                                                <Font name="System Bold" size="28.0" />
                                            </font>
                                        </Label>

                                        <Label text="Select a menu item from the left to get started" textFill="#a0aec0">
                                            <font>
                                                <Font size="16.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>

                    </children>
                </VBox>

            </children>
        </HBox>

    </children>
</StackPane>
