<?xml version="1.0" encoding="utf-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<StackPane fx:id="rootPane" minHeight="600.0" minWidth="900.0" prefHeight="900.0" prefWidth="1440.0" stylesheets="@/CSS/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.HomeScreenController">
    <children>
        <HBox style="-fx-background-color: #ffffff;">
            <children>
                <VBox maxWidth="230.0" minWidth="230.0" prefWidth="230.0" spacing="5.0" style="-fx-background-color: #ffffff; -fx-border-color: #f0f0f0; -fx-border-width: 0 1 0 0; -fx-padding: 20 15 20 15;">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="5.0">
                            <children>
                                <ImageView fitHeight="60.0" fitWidth="65.0" pickOnBounds="true" preserveRatio="true" smooth="true">
                                    <image>
                                        <Image url="@../../CSS/logo.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="my-darley" text="BubblyBid" textFill="#1a1a1a">
                                    <font>
                                        <Font name="Darley Sans" size="27.0" />
                                    </font>
                                </Label>
                            </children>
                            <VBox.margin>
                                <Insets bottom="30.0" left="0.0" top="-10.0" />
                            </VBox.margin>
                        </HBox>
                        <HBox fx:id="menuHome" alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#handleMenuClick" prefHeight="45.0" prefWidth="230.0" style="-fx-background-radius: 8; -fx-cursor: hand;" styleClass="menu-item">
                            <children>
                                <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" maxWidth="Infinity" mouseTransparent="true" style="-fx-background-color: transparent;" text="🏠   Trang chủ" textFill="#4a5568" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font name="System" size="17.0" />
                                    </font>
                                    <padding>
                                        <Insets left="20.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>
                        <Label text="ĐẤU GIÁ" textFill="#a0aec0">
                            <font>
                                <Font size="15.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="5.0" left="20.0" top="20.0" />
                            </VBox.margin>
                        </Label>
                        <HBox fx:id="menuRecent" alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#handleMenuClick" prefHeight="45.0" prefWidth="230.0" style="-fx-background-radius: 8; -fx-cursor: hand;" styleClass="menu-item">
                            <children>
                                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mouseTransparent="true" onAction="#loadAuctionHistoryView" style="-fx-background-color: transparent;" text="📈   Lịch sử đấu giá" textFill="#4a5568" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font size="17.0" />
                                    </font>
                                    <padding>
                                        <Insets left="20.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>
                        <HBox fx:id="menuMsg" alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#handleMenuClick" prefHeight="45.0" prefWidth="230.0" style="-fx-background-radius: 8; -fx-cursor: hand;" styleClass="menu-item">
                            <children>
                                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mouseTransparent="true" onMouseClicked="#loadNotificationsView" style="-fx-background-color: transparent;" text="🔔   Thông báo" textFill="#4a5568" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font size="17.0" />
                                    </font>
                                    <padding>
                                        <Insets left="20.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>
                        <HBox fx:id="menuPay" alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#loadWalletView" prefHeight="45.0" prefWidth="230.0" style="-fx-background-radius: 8; -fx-cursor: hand;" styleClass="menu-item">
                            <children>
                                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mouseTransparent="true" style="-fx-background-color: transparent;" text="💳   Ví tiền" textFill="#4a5568" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font size="17.0" />
                                    </font>
                                    <padding>
                                        <Insets left="20.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>
                        <Region VBox.vgrow="ALWAYS" />
                        <HBox fx:id="menuUpgrade" alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#handleMenuClick" prefHeight="45.0" prefWidth="230.0" style="-fx-background-radius: 8; -fx-cursor: hand;" styleClass="menu-item">
                            <children>
                                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mouseTransparent="true" style="-fx-background-color: transparent; -fx-font-family: 'System'; -fx-font-size: 17px; -fx-font-weight: normal;" text="Trở thành Seller" textFill="#e53e3e" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font name="System" size="17.0" />
                                    </font>
                                    <padding>
                                        <Insets left="20.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>
                        <HBox fx:id="menuSettings" alignment="CENTER_LEFT" maxWidth="Infinity" onMouseClicked="#handleMenuClick" prefHeight="45.0" prefWidth="230.0" style="-fx-background-radius: 8; -fx-cursor: hand;" styleClass="menu-item">
                            <children>
                                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mouseTransparent="true" onAction="#handleLogout" style="-fx-background-color: transparent;" text="🚪   Đăng xuất" textFill="#e53e3e" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                    <padding>
                                        <Insets left="18.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox minWidth="0.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" maxHeight="80.0" minHeight="80.0" prefHeight="80.0" style="-fx-background-color: #ffffff; -fx-padding: 0 40 0 40; -fx-border-color: #f0f0f0; -fx-border-width: 0 0 1 0;">
                            <children>
                                <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" prefHeight="48.0" prefWidth="500.0" style="-fx-background-color: #f3f4f6; -fx-background-radius: 24; -fx-padding: 0 20 0 20;">
                                    <children>
                                        <Label style="-fx-font-size: 16px;" text="🔍" textFill="#9ca3af" />
                                        <TextField fx:id="productSearchInput" onAction="#handleProductSearch" promptText="Tìm kiếm sản phẩm..." style="-fx-background-color: transparent; -fx-prompt-text-fill: #9ca3af; -fx-text-fill: #374151;" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font size="15.0" />
                                            </font>
                                            <padding>
                                                <Insets left="10.0" />
                                            </padding>
                                        </TextField>
                                        <Button fx:id="clearSearchBtn" onAction="#clearSearch" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#9ca3af" visible="false">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#loadProfileView" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #e2e8f0; -fx-background-radius: 20; -fx-cursor: hand;" text="👤">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                    <HBox.margin>
                                        <Insets left="20.0" />
                                    </HBox.margin>
                                </Button>
                            </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                            <content>
                        <StackPane fx:id="contentArea" minWidth="0.0" style="-fx-background-color: #fcfcfc;">
                            <children>
                                <VBox alignment="CENTER" minHeight="600" spacing="10.0">
                                    <children>
                                        <Label style="-fx-translate-x: -3;" text="Chào mừng đến với BubblyBid" textFill="#2e384d">
                                            <font>
                                                <Font name="System Bold" size="28.0" />
                                            </font>
                                        </Label>
                                        <Label text="Chọn một mục ở menu bên trái để bắt đầu" textFill="#a0aec0">
                                            <font>
                                                <Font size="16.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>
