<?xml version="1.0" encoding="utf-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<VBox styleClass="auction-history-view" stylesheets="@/CSS/table.css" alignment="TOP_LEFT" spacing="30.0" style="-fx-background-color: #fcfcfc;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.AuctionHistoryController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>
    <children>
        <VBox spacing="5.0">
            <children>
                <Label opacity="1.0" style="-fx-text-fill: #111827; -fx-font-size: 28px; -fx-font-weight: bold;" styleClass="auction-history-title" text="Lịch sử đấu giá" textFill="#111827">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Label opacity="1.0" style="-fx-text-fill: #4b5563; -fx-font-size: 15px;" styleClass="auction-history-subtitle" text="Toàn bộ lịch sử đặt giá của bạn. Theo dõi trạng thái và đối chiếu các phiên đấu giá." textFill="#4b5563">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>
            </children>
        </VBox>
        <Separator prefWidth="200.0" style="-fx-opacity: 0.3;" />
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <ComboBox fx:id="statusFilter" prefHeight="45.0" prefWidth="180.0" promptText="Tất cả trạng thái" style="-fx-background-color: #f3f4f6; -fx-background-radius: 10; -fx-font-size: 14px; -fx-cursor: hand;" />
                <ComboBox fx:id="timeFilter" prefHeight="45.0" prefWidth="160.0" promptText="Tháng này" style="-fx-background-color: #f3f4f6; -fx-background-radius: 10; -fx-font-size: 14px; -fx-cursor: hand;" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" prefHeight="45.0" prefWidth="280.0" promptText="Nhập tên sản phẩm..." style="-fx-background-color: #f3f4f6; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 0 15 0 15;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>
                <Button onAction="#handleSearch" prefHeight="45.0" style="-fx-background-color: #1a1a1a; -fx-background-radius: 10; -fx-cursor: hand;" text="Tìm kiếm" textFill="white">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <padding>
                        <Insets left="25.0" right="25.0" />
                    </padding>
                </Button>
            </children>
        </HBox>
        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #f3f4f6; -fx-border-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="historyTable" fixedCellSize="60.0" prefHeight="450.0" style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-selection-bar: #f1f5f9;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="dateColumn" prefWidth="180.0" text="Ngày giờ" />
                        <TableColumn fx:id="productNameColumn" prefWidth="300.0" text="Sản phẩm" />
                        <TableColumn fx:id="bidAmountColumn" prefWidth="160.0" text="Giá bạn đặt" />
                        <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Trạng thái" />
                        <TableColumn fx:id="actionColumn" minWidth="150.0" prefWidth="180.0" text="Thao tác" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Chưa có dữ liệu lịch sử đấu giá" textFill="#a0aec0">
                            <font>
                                <Font size="15.0" />
                            </font>
                        </Label>
                    </placeholder>
                </TableView>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </children>
</VBox>
