<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<HBox fx:id="cardRoot" spacing="15" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 15; -fx-border-radius: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <StackPane maxHeight="150" maxWidth="150" minHeight="150" minWidth="150">
        <ImageView fitHeight="150" fitWidth="150" preserveRatio="false">
            <clip>
                <Rectangle arcHeight="30.0" arcWidth="30.0" height="150.0" width="150.0" />
            </clip>
        </ImageView>
    </StackPane>

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <children>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Tên sản phẩm đấu giá" />

            <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Người bán: Nguyễn Văn A" />

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label style="-fx-background-color: #e1f5fe; -fx-text-fill: #039be5; -fx-padding: 4 12; -fx-background-radius: 20; -fx-font-size: 11px; -fx-font-weight: bold;" text="#abc" />
                <Label style="-fx-background-color: #e1f5fe; -fx-text-fill: #039be5; -fx-padding: 4 12; -fx-background-radius: 20; -fx-font-size: 11px; -fx-font-weight: bold;" text="#edf" />
            </HBox>

            <Region VBox.vgrow="ALWAYS" /> <HBox alignment="BOTTOM_RIGHT">
            <Button mnemonicParsing="false" style="-fx-background-color: #0a0a0a; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;" text="Đấu giá ngày" />
        </HBox>
        </children>
    </VBox>
</HBox>
