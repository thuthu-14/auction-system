<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxWidth="280.0" minWidth="280.0" prefHeight="390.0" prefWidth="280.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #f3f4f6; -fx-border-radius: 12; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.AuctionCardController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <StackPane fx:id="imageContainer" maxHeight="250.0" maxWidth="250.0" minHeight="250.0" minWidth="250.0" prefHeight="250.0" prefWidth="250.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8;" VBox.vgrow="NEVER">
            <children>
                <ImageView fx:id="productImageView" fitHeight="250.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="false" smooth="true" />
            </children>
        </StackPane>

        <Label fx:id="productNameLabel" maxHeight="42.0" maxWidth="1.7976931348623157E308" minHeight="42.0" text="MacBook Pro M3 Max 36GB" textFill="#113254" wrapText="true">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="5.0">
            <children>
                <Label fx:id="timerLabel" text="⏱ Còn 00:05:12" textFill="#e53e3e">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="priceLabel" text="55.500.000 đ" textFill="#000000">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Label>
            </children>
        </HBox>

        <Button fx:id="bidButton" maxWidth="1.7976931348623157E308" prefHeight="40.0" style="-fx-background-color: #1a1a1a; -fx-background-radius: 20; -fx-cursor: hand;" text="Đặt giá" textFill="white">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>
    </children>
</VBox>
