<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0"
      prefWidth="1100.0"
      spacing="30.0"
      style="-fx-background-color: #fcfcfc;"
      stylesheets="@../../CSS/table.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.controller.AdminAuctionManagementController">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Quản lý phiên đấu giá" textFill="#1a1a1a">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Label text="Theo dõi, lọc và sắp xếp các phiên đấu giá trong hệ thống" textFill="#4a5568">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="20.0"
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #f3f4f6; -fx-border-radius: 15; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 2);"
              VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <HBox alignment="CENTER_LEFT"
                              maxHeight="-Infinity"
                              maxWidth="280.0"
                              prefHeight="40.0"
                              style="-fx-background-color: #f3f4f6; -fx-background-radius: 20; -fx-padding: 0 15 0 15;"
                              HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="🔍" textFill="#9ca3af">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="searchBidInput"
                                           promptText="Tìm mã phiên, sản phẩm, người bán..."
                                           style="-fx-background-color: transparent; -fx-prompt-text-fill: #9ca3af; -fx-text-fill: #1a1a1a;"
                                           HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </TextField>
                            </children>
                        </HBox>

                        <ComboBox fx:id="filterStatus"
                                  prefHeight="40.0"
                                  prefWidth="150.0"
                                  promptText="Trạng thái" />

                        <DatePicker fx:id="filterStartDate"
                                    prefHeight="40.0"
                                    prefWidth="145.0"
                                    promptText="Từ ngày" />

                        <DatePicker fx:id="filterEndDate"
                                    prefHeight="40.0"
                                    prefWidth="145.0"
                                    promptText="Đến ngày" />

                        <ComboBox fx:id="sortOptions"
                                  prefHeight="40.0"
                                  prefWidth="165.0"
                                  promptText="Sắp xếp" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnRefresh"
                                style="-fx-background-color: #f3f4f6; -fx-text-fill: #4a5568; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20 8 20;"
                                text="Làm mới">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <Label fx:id="totalLabel" text="Tổng số: 0 phiên đấu giá" textFill="#4a5568">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <VBox style="-fx-border-color: #f3f4f6; -fx-border-radius: 15; -fx-background-radius: 15; -fx-background-color: #ffffff;"
                      VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tableBids"
                                   style="-fx-background-color: transparent; -fx-selection-bar: #e0f2fe; -fx-selection-bar-non-focused: #f3f4f6; -fx-border-color: transparent;"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colBidId"
                                             prefWidth="145.0"
                                             style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-alignment: CENTER;"
                                             text="Mã phiên" />
                                <TableColumn fx:id="colAuctionId"
                                             prefWidth="145.0"
                                             style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-alignment: CENTER;"
                                             text="Mã sản phẩm" />
                                <TableColumn fx:id="colBidderId"
                                             prefWidth="140.0"
                                             style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-alignment: CENTER;"
                                             text="Người bán" />
                                <TableColumn fx:id="colBidderName"
                                             prefWidth="260.0"
                                             style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;"
                                             text="Sản phẩm" />
                                <TableColumn fx:id="colAmount"
                                             prefWidth="150.0"
                                             style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-alignment: CENTER-RIGHT;"
                                             text="Giá hiện tại" />
                                <TableColumn fx:id="colBidTime"
                                             prefWidth="160.0"
                                             style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-alignment: CENTER;"
                                             text="Kết thúc" />
                                <TableColumn fx:id="colStatus"
                                             prefWidth="130.0"
                                             style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-alignment: CENTER;"
                                             text="Trạng thái" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>
