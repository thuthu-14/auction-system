<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="0" stylesheets="@../CSS/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.SellerDashboardController">


    <!-- CARDS GRID -->
    <ScrollPane fitToWidth="true" styleClass="bar" VBox.vgrow="ALWAYS">
        <VBox styleClass="dashboard-cards-container">

            <!-- ROW 1: Tạo phiên + Quản lý phiên -->
            <HBox spacing="16">

                <VBox fx:id="cardTaoPhien" minHeight="120" onMouseClicked="#onCardClick" onMouseEntered="#onCardEnter" onMouseExited="#onCardExit" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="card-icon-badge card-icon-purple" style="-fx-font-size: 20px;" text="➕" />
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="Tạo phiên mới" />
                            <Label styleClass="card-desc" text="Khởi tạo phiên đấu giá với sản phẩm của bạn" wrapText="true" />
                        </VBox>
                    </HBox>
                    <Region VBox.vgrow="ALWAYS" />
                    <HBox alignment="CENTER_RIGHT">
                        <Label styleClass="card-cta card-cta-purple" text="Bắt đầu →" />
                    </HBox>
                </VBox>

                <VBox fx:id="cardQuanLyPhien" minHeight="120" onMouseClicked="#onCardClick" onMouseEntered="#onCardEnter" onMouseExited="#onCardExit" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="card-icon-badge card-icon-teal" style="-fx-font-size: 20px;" text="⚖" />
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="Quản lý phiên" />
                            <Label styleClass="card-desc" text="Theo dõi và điều phối các phiên đang diễn ra" wrapText="true" />
                        </VBox>
                    </HBox>
                    <Region VBox.vgrow="ALWAYS" />
                    <HBox alignment="CENTER_RIGHT">
                        <Label styleClass="card-cta card-cta-teal" text="Xem ngay →" />
                    </HBox>
                </VBox>

            </HBox>

            <!-- ROW 2: Thống kê + Thông báo -->
            <HBox spacing="16">

                <VBox fx:id="cardThongKe" minHeight="120" onMouseClicked="#onCardClick" onMouseEntered="#onCardEnter" onMouseExited="#onCardExit" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="card-icon-badge card-icon-orange" style="-fx-font-size: 20px;" text="📊" />
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="Thống kê" />
                            <Label styleClass="card-desc" text="Xem báo cáo doanh thu và hiệu suất bán hàng" wrapText="true" />
                        </VBox>
                    </HBox>
                    <Region VBox.vgrow="ALWAYS" />
                    <HBox alignment="CENTER_RIGHT">
                        <Label styleClass="card-cta card-cta-orange" text="Phân tích →" />
                    </HBox>
                </VBox>

                <VBox fx:id="cardThongBao" minHeight="120" onMouseClicked="#onCardClick" onMouseEntered="#onCardEnter" onMouseExited="#onCardExit" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="card-icon-badge card-icon-pink" style="-fx-font-size: 20px;" text="🔔">
                     <font>
                        <Font size="22.0" />
                     </font></Label>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="Thông báo" />
                            <Label styleClass="card-desc" text="Cập nhật tin tức về các phiên và người đấu giá" wrapText="true" />
                        </VBox>
                    </HBox>
                    <Region VBox.vgrow="ALWAYS" />
                    <HBox alignment="CENTER_RIGHT">
                        <Label styleClass="card-cta card-cta-pink" text="Đọc thêm →" />
                    </HBox>
                </VBox>

            </HBox>

            <!-- ROW 3: Ví tiền full width -->
            <HBox>
                <VBox fx:id="cardViTien" minHeight="120" onMouseClicked="#onCardClick" onMouseEntered="#onCardEnter" onMouseExited="#onCardExit" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="card-icon-badge card-icon-blue" style="-fx-font-size: 20px;" text="💳" />
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="Ví tiền" />
                            <Label styleClass="card-desc" text="Quản lý số dư, nạp tiền và lịch sử giao dịch của bạn" wrapText="true" />
                        </VBox>
                    </HBox>
                    <Region VBox.vgrow="ALWAYS" />
                    <HBox alignment="CENTER_RIGHT">
                        <Label styleClass="card-cta card-cta-blue" text="Quản lý →" />
                    </HBox>
                </VBox>
            </HBox>

        </VBox>
    </ScrollPane>

</VBox>
