<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox spacing="25.0" style="-fx-background-color: #fcfcfc;" stylesheets="@../CSS/table.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.AddAuctionProductController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <VBox minWidth="250.0" prefWidth="250.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #f3f4f6; -fx-border-radius: 12; -fx-border-width: 1;">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
        <Label text="Gợi ý điền Thông tin" textFill="#1a1a1a" styleClass="field-label">
            <font><Font name="System Bold" size="16.0" /></font>
        </Label>
        <Separator />
        <Label text="✓ Thêm ít nhất 3 hình ảnh" textFill="#718096" />
        <Label text="✓ Tên sản phẩm 25~100 kí tự" textFill="#718096" />
        <Label text="✓ Thiết lập thời gian rõ ràng" textFill="#718096" />
        <Label text="✓ Đặt mức giá mong muốn hợp lý" textFill="#718096" />
    </VBox>

    <ScrollPane fx:id="formScrollPane" fitToWidth="true" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;" HBox.hgrow="ALWAYS">
        <content>
            <VBox maxWidth="1.7976931348623157E308" spacing="25.0">

                <VBox maxWidth="1.7976931348623157E308" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #f3f4f6; -fx-border-radius: 12; -fx-border-width: 1;">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <Label text="Thông tin cơ bản" textFill="#1a1a1a" styleClass="field-label">
                        <font><Font name="System Bold" size="18.0" /></font>
                    </Label>

                    <VBox maxWidth="1.7976931348623157E308" spacing="5.0">
                        <Label text="* Tên sản phẩm" textFill="#4a5568" styleClass="field-label">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="productNameField" maxWidth="1.7976931348623157E308" prefHeight="40.0" promptText="Tên sản phẩm + Thương hiệu + Model..." style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-color: #f8fafc;" />
                    </VBox>

                    <VBox maxWidth="1.7976931348623157E308" spacing="5.0">
                        <Label text="* Ngành hàng" textFill="#4a5568" styleClass="field-label">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <ComboBox fx:id="categoryComboBox" maxWidth="1.7976931348623157E308" onAction="#handleCategoryChange" prefHeight="40.0" promptText="Chọn ngành hàng" style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-color: #f8fafc;" />
                    </VBox>
                </VBox>

                <VBox fx:id="categoryFormPane" maxWidth="1.7976931348623157E308" minHeight="400.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #f3f4f6; -fx-border-radius: 12; -fx-border-width: 1;">
                    <VBox alignment="CENTER" spacing="10.0">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                        <Label text="Chọn ngành hàng để bắt đầu" textFill="#a0aec0" styleClass="field-label">
                            <font><Font size="14.0" /></font>
                        </Label>
                    </VBox>
                </VBox>

                <VBox maxWidth="1.7976931348623157E308" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #f3f4f6; -fx-border-radius: 12; -fx-border-width: 1;">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <Label text="Mô tả chi tiết" textFill="#1a1a1a" styleClass="field-label">
                        <font><Font name="System Bold" size="18.0" /></font>
                    </Label>

                    <VBox maxWidth="1.7976931348623157E308" spacing="10.0">
                        <Label text="Hình ảnh sản phẩm (Tối đa 5 ảnh - Tỷ lệ 1:1)" textFill="#4a5568" styleClass="field-label">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                            <Button onAction="#handleSelectImage" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-style: dashed; -fx-border-width: 2; -fx-text-fill: #4a5568; -fx-pref-width: 100; -fx-pref-height: 100; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;" text="+ Thêm ảnh" />

                            <HBox fx:id="imagePreviewContainer" spacing="10.0" alignment="CENTER_LEFT" />
                        </HBox>
                    </VBox>

                    <VBox maxWidth="1.7976931348623157E308" spacing="5.0" VBox.vgrow="ALWAYS">
                        <Label text="* Mô tả sản phẩm" textFill="#4a5568" styleClass="field-label">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextArea fx:id="descriptionArea" maxWidth="1.7976931348623157E308" prefHeight="150.0" promptText="Nhập mô tả sản phẩm..." style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-control-inner-background: #f8fafc;" />
                    </VBox>
                </VBox>

                <HBox alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" spacing="15.0" style="-fx-padding: 10 0 0 0;">
                    <Button onAction="#handleCancel" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-radius: 20; -fx-text-fill: #4a5568; -fx-cursor: hand;" text="Hủy">
                        <font><Font name="System Bold" size="14.0" /></font>
                    </Button>
                    <Button onAction="#handleSaveAndPublish" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand;" text="Lưu &amp; Hiển thị">
                        <font><Font name="System Bold" size="14.0" /></font>
                    </Button>
                </HBox>

            </VBox>
        </content>
    </ScrollPane>
</HBox>
