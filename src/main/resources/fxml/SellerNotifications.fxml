<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="NEVER" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.SellerNotificationsController">

    <VBox spacing="25.0" style="-fx-background-color: #fcfcfc;">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <HBox alignment="CENTER_LEFT">
            <children>
                <Label style="-fx-text-fill: #1a1a1a;" text="🔔 Thông báo cửa hàng" textFill="#1a1a1a">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="markAllReadBtn" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #3182ce; -fx-underline: true;" text="Đánh dấu đã đọc tất cả">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <VBox fx:id="notificationsContainer" spacing="15.0" />

    </VBox>
</ScrollPane>
