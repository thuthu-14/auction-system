<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.SellerNotificationsController">

    <VBox spacing="25.0" style="-fx-background-color: #fcfcfc;">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <HBox alignment="CENTER_LEFT">
            <children>
                <Label text="🔔 Thông báo cửa hàng" textFill="#1a1a1a">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="markAllReadBtn" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #3182ce; -fx-underline: true;" text="Đánh dấu đã đọc tất cả">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <VBox spacing="15.0">

            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #22c55e; -fx-border-radius: 15; -fx-border-width: 2; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(34,197,94,0.2), 15, 0, 0, 5);">
                <children>
                    <VBox alignment="CENTER" prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #dcfce3; -fx-background-radius: 30;">
                        <Label text="💰" textFill="#166534">
                            <font><Font size="28.0" /></font>
                        </Label>
                    </VBox>

                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Chốt đơn thành công!" textFill="#166534">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <Label text="Tuyệt vời! Sản phẩm 'Đồng hồ Rolex Submariner' đã được bán với giá chốt 215.000.000 đ. Người mua đã thanh toán, vui lòng chuẩn bị giao hàng." textFill="#4a5568" wrapText="true">
                            <font><Font size="14.0" /></font>
                        </Label>
                    </VBox>

                    <VBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Label text="Vừa xong" textFill="#9ca3af">
                            <font><Font size="12.0" /></font>
                        </Label>
                        <Button fx:id="shipOrderBtn" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20 8 20;" text="Giao hàng ngay">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </VBox>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #f3f4f6; -fx-border-radius: 15; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 2);">
                <children>
                    <VBox alignment="CENTER" prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #ffedd5; -fx-background-radius: 30;">
                        <Label text="🔥" textFill="#c2410c">
                            <font><Font size="28.0" /></font>
                        </Label>
                    </VBox>

                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Đã vượt mức giá mong muốn!" textFill="#1a1a1a">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <Label text="Tin vui! Sản phẩm 'Tranh sơn dầu phong cảnh' hiện đã đạt 12.000.000 đ (vượt qua giá bảo lưu). Chắc chắn sản phẩm này sẽ được bán!" textFill="#4a5568" wrapText="true">
                            <font><Font size="14.0" /></font>
                        </Label>
                    </VBox>

                    <VBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Label text="2 giờ trước" textFill="#9ca3af">
                            <font><Font size="12.0" /></font>
                        </Label>
                        <Button fx:id="viewAuctionBtn" style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20 8 20;" text="Xem diễn biến">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </VBox>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #f3f4f6; -fx-border-radius: 15; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 2);">
                <children>
                    <VBox alignment="CENTER" prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 30;">
                        <Label text="🔄" textFill="#475569">
                            <font><Font size="28.0" /></font>
                        </Label>
                    </VBox>

                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Phiên đấu giá kết thúc" textFill="#475569">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <Label text="Rất tiếc, sản phẩm 'Bình gốm cổ Minh' đã hết hạn mà không đạt được mức giá kỳ vọng. Bạn có muốn đăng lại với khởi điểm hấp dẫn hơn?" textFill="#4a5568" wrapText="true">
                            <font><Font size="14.0" /></font>
                        </Label>
                    </VBox>

                    <VBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Label text="1 ngày trước" textFill="#9ca3af">
                            <font><Font size="12.0" /></font>
                        </Label>
                        <Button fx:id="relistBtn" style="-fx-background-color: #f3f4f6; -fx-text-fill: #4a5568; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-border-color: #cbd5e1; -fx-border-radius: 20;" text="Đăng lại ngay">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </VBox>
                </children>
            </HBox>

        </VBox>
    </VBox>
</ScrollPane>
