<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0"
      prefWidth="1100.0"
      spacing="30.0"
      style="-fx-background-color: #fcfcfc;"
      stylesheets="@../CSS/table.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.controller.UserManagementController">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Quản lý người dùng" textFill="#1a1a1a">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Label text="Xem danh sách, khóa và mở khóa tài khoản thành viên hệ thống" textFill="#4a5568">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="20.0"
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #f3f4f6; -fx-border-radius: 15; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 2);"
              VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <HBox alignment="CENTER_LEFT"
                              maxHeight="-Infinity"
                              maxWidth="350.0"
                              prefHeight="40.0"
                              style="-fx-background-color: #f3f4f6; -fx-background-radius: 20; -fx-padding: 0 15 0 15;"
                              HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="🔍" textFill="#9ca3af">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="searchUserInput"
                                           promptText="Tìm theo tên, email, vai trò..."
                                           style="-fx-background-color: transparent; -fx-prompt-text-fill: #9ca3af; -fx-text-fill: #1a1a1a;"
                                           HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </TextField>
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnRefresh"
                                style="-fx-background-color: #f3f4f6; -fx-text-fill: #4a5568; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20 8 20;"
                                text="Làm mới">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>

                        <Button fx:id="btnUnlock"
                                style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20 8 20;"
                                text="Mở khóa">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>

                        <Button fx:id="btnLock"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20 8 20;"
                                text="Khóa tài khoản">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <VBox style="-fx-border-color: #f3f4f6; -fx-border-radius: 15; -fx-background-radius: 15; -fx-background-color: #ffffff;"
                      VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="userTable"
                                   style="-fx-background-color: transparent; -fx-selection-bar: #e0f2fe; -fx-selection-bar-non-focused: #f3f4f6; -fx-border-color: transparent;"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId"
                                             prefWidth="120.0"
                                             style="-fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-alignment: CENTER;"
                                             text="ID" />
                                <TableColumn fx:id="colUsername"
                                             prefWidth="360.0"
                                             style="-fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-alignment: CENTER-LEFT;"
                                             text="Người dùng" />
                                <TableColumn fx:id="colRole"
                                             prefWidth="200.0"
                                             style="-fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-alignment: CENTER;"
                                             text="Vai trò" />
                                <TableColumn fx:id="colStatus"
                                             prefWidth="220.0"
                                             style="-fx-font-family: 'Segoe UI'; -fx-font-size: 15px; -fx-alignment: CENTER;"
                                             text="Trạng thái" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>
