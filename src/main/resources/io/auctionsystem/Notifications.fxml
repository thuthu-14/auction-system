<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #fcfcfc;" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.auctionsystem.controllers.NotificationsController">

    <VBox spacing="25.0" style="-fx-background-color: #fcfcfc;">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <HBox alignment="CENTER_LEFT">
            <children>
                <Label text="🔔 Thông báo của bạn" textFill="#1a1a1a">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="markAllReadBtn" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #3182ce; -fx-underline: true;" text="Đánh dấu đã đọc tất cả">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <VBox spacing="15.0">

            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #fde047; -fx-border-radius: 15; -fx-border-width: 2; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(253,224,71,0.2), 15, 0, 0, 5);">
                <children>
                    <VBox alignment="CENTER" prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #fef08a; -fx-background-radius: 30;">
                        <Label text="🏆" textFill="#854d0e">
                            <font><Font size="28.0" /></font>
                        </Label>
                    </VBox>

                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Thắng đấu giá!" textFill="#b45309">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <Label text="Tuyệt vời! Bạn đã là người chiến thắng phiên đấu giá MacBook Pro M3 Max với mức giá 55.500.000 đ." textFill="#4a5568" wrapText="true">
                            <font><Font size="14.0" /></font>
                        </Label>
                    </VBox>

                    <VBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Label text="Vừa xong" textFill="#9ca3af">
                            <font><Font size="12.0" /></font>
                        </Label>
                        <Button fx:id="payNowBtn" style="-fx-background-color: #facc15; -fx-text-fill: #1a1a1a; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20 8 20;" text="Thanh toán ngay">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </VBox>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #f3f4f6; -fx-border-radius: 15; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 2);">
                <children>
                    <VBox alignment="CENTER" prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #fee2e2; -fx-background-radius: 30;">
                        <Label text="⚠" textFill="#991b1b">
                            <font><Font size="28.0" /></font>
                        </Label>
                    </VBox>

                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Có người đã trả giá cao hơn!" textFill="#1a1a1a">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <Label text="User @jack09 vừa đặt 38.500.000 đ cho iPhone 15 Pro Max. Hãy nhanh tay đặt giá mới trước khi hết giờ!" textFill="#4a5568" wrapText="true">
                            <font><Font size="14.0" /></font>
                        </Label>
                    </VBox>

                    <VBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Label text="10 phút trước" textFill="#9ca3af">
                            <font><Font size="12.0" /></font>
                        </Label>
                        <Button fx:id="rebidBtn" style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20 8 20;" text="Đấu giá lại">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </VBox>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #f3f4f6; -fx-border-radius: 15; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 2);">
                <children>
                    <VBox alignment="CENTER" prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #e0f2fe; -fx-background-radius: 30;">
                        <Label text="✨" textFill="#075985">
                            <font><Font size="28.0" /></font>
                        </Label>
                    </VBox>

                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Chào mừng đến với BubblyBid" textFill="#1a1a1a">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <Label text="Tài khoản của bạn đã được xác thực thành công. Bắt đầu khám phá hàng ngàn món hời ngay hôm nay nhé!" textFill="#4a5568" wrapText="true">
                            <font><Font size="14.0" /></font>
                        </Label>
                    </VBox>

                    <VBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Label text="2 ngày trước" textFill="#9ca3af">
                            <font><Font size="12.0" /></font>
                        </Label>
                        <Button fx:id="viewProfileBtn" style="-fx-background-color: #f3f4f6; -fx-text-fill: #4a5568; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 20 8 20;" text="Xem hồ sơ">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </VBox>
                </children>
            </HBox>

        </VBox>
    </VBox>
</ScrollPane>