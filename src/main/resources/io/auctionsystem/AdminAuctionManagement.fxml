<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane stylesheets="@../../CSS/table.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>

        <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" spacing="20.0" style="-fx-background-color: #fcfcfc; -fx-padding: 30;">
            <children>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox>
                            <children>
                                <Label text="Quản lý Lượt Trả Giá" textFill="#2e384d">
                                    <font><Font name="System Bold" size="28.0" /></font>
                                </Label>
                                <Label text="Giám sát toàn bộ các lượt đặt giá trên hệ thống để phát hiện bất thường." textFill="#718096">
                                    <font><Font size="14.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnRefresh" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 16;" text="🔄 Làm mới dữ liệu" textFill="#4a5568">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </children>
                </HBox>

                <VBox spacing="15.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 20;">
                    <children>
                        <Label text="Bộ lọc &amp; Tìm kiếm" textFill="#4a5568">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>

                        <HBox spacing="15.0">
                            <children>
                                <TextField fx:id="searchBidInput" prefWidth="250.0" promptText="🔍 Tìm mã bid, mã phiên, user..." style="-fx-background-color: #f3f4f6; -fx-background-radius: 6; -fx-padding: 10;" />

                                <ComboBox fx:id="filterStatus" prefWidth="150.0" promptText="Trạng thái" style="-fx-background-color: #f3f4f6; -fx-background-radius: 6; -fx-padding: 4;" />

                                <DatePicker fx:id="filterStartDate" promptText="Từ ngày" style="-fx-background-color: #f3f4f6; -fx-background-radius: 6;" />
                                <DatePicker fx:id="filterEndDate" promptText="Đến ngày" style="-fx-background-color: #f3f4f6; -fx-background-radius: 6;" />

                                <Region HBox.hgrow="ALWAYS" />

                                <Label alignment="CENTER" text="Sắp xếp:" textFill="#718096" translateY="8.0" />
                                <ComboBox fx:id="sortOptions" prefWidth="160.0" promptText="Mới nhất trước" style="-fx-background-color: #f3f4f6; -fx-background-radius: 6; -fx-padding: 4;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tableBids" styleClass="custom-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colBidId" prefWidth="90.0" text="Mã Bid" />
                                <TableColumn fx:id="colAuctionId" prefWidth="100.0" text="Mã Phiên" />
                                <TableColumn fx:id="colBidderId" prefWidth="100.0" text="Mã User" />
                                <TableColumn fx:id="colBidderName" prefWidth="150.0" text="Tên Người đặt" />
                                <TableColumn fx:id="colAmount" prefWidth="150.0" text="Mức giá (VND)" />
                                <TableColumn fx:id="colBidTime" prefWidth="150.0" text="Thời gian" />
                                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Trạng thái" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Label text="Tổng số: 1,205 lượt đặt" textFill="#718096" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>