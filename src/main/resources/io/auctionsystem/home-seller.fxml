<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.auctionsystem.controllers.HomeSellerController"
      alignment="CENTER"
      spacing="14"
      style="-fx-background-color: #fcfcfc;">

    <padding>
        <Insets top="40" right="30" bottom="40" left="30"/>
    </padding>

    <Label text="Welcome to Seller Home"
           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #2e384d;"/>

    <Label text="Đây là màn hình mặc định dành cho người bán."
           style="-fx-font-size: 16px; -fx-text-fill: #94a3b8;"/>

    <Label text="Bạn có thể quản lý phiên đấu giá và theo dõi người bid tại đây."
           style="-fx-font-size: 15px; -fx-text-fill: #64748b;"/>
</VBox>