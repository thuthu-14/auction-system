<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane"
           prefHeight="900.0"
           prefWidth="1440.0"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="io.auctionsystem.controllers.HomeController">

    <children>
        <HBox prefHeight="900.0"
              prefWidth="1440.0"
              style="-fx-background-color: #ffffff;">

            <children>
                <!-- SIDEBAR -->
                <VBox prefWidth="240.0"
                      spacing="8.0"
                      style="-fx-background-color: #ffffff; -fx-border-color: #f0f0f0; -fx-border-width: 0 1 0 0; -fx-padding: 20 15 20 15;">

                    <children>
                        <Label text="BubblyBid"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2e384d;">
                            <VBox.margin>
                                <Insets bottom="20.0" left="10.0"/>
                            </VBox.margin>
                        </Label>

                        <HBox fx:id="menuHome"
                              alignment="CENTER_LEFT"
                              prefHeight="45.0"
                              onMouseClicked="#handleMenuClick"
                              style="-fx-background-radius: 8; -fx-cursor: hand;">
                            <children>
                                <Button text="🏠   Trang chủ"
                                        mouseTransparent="true"
                                        prefWidth="220.0"
                                        style="-fx-background-color: transparent; -fx-text-fill: #4a5568; -fx-font-size: 16px;"/>
                            </children>
                        </HBox>

                        <HBox fx:id="menuAskAI"
                              alignment="CENTER_LEFT"
                              prefHeight="45.0"
                              onMouseClicked="#handleMenuClick"
                              style="-fx-background-radius: 8; -fx-cursor: hand;">
                            <children>
                                <Button text="☁️   Ask AI"
                                        mouseTransparent="true"
                                        prefWidth="220.0"
                                        style="-fx-background-color: transparent; -fx-text-fill: #4a5568; -fx-font-size: 16px;"/>
                            </children>
                        </HBox>

                        <HBox fx:id="menuFlashBid"
                              alignment="CENTER_LEFT"
                              prefHeight="45.0"
                              onMouseClicked="#handleMenuClick"
                              style="-fx-background-radius: 8; -fx-cursor: hand;">
                            <children>
                                <Button text="⚡   Flash Bid"
                                        mouseTransparent="true"
                                        prefWidth="220.0"
                                        style="-fx-background-color: transparent; -fx-text-fill: #4a5568; -fx-font-size: 16px;"/>
                            </children>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <!-- SELLER / SETTINGS ở cuối -->
                        <HBox fx:id="menuBecomeSeller"
                              alignment="CENTER_LEFT"
                              prefHeight="45.0"
                              onMouseClicked="#handleMenuClick"
                              style="-fx-background-radius: 8; -fx-cursor: hand;">
                            <children>
                                <Button text="👨‍🏫   Trở thành Người bán"
                                        mouseTransparent="true"
                                        prefWidth="220.0"
                                        style="-fx-background-color: transparent; -fx-text-fill: #e53e3e; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>

                        <HBox fx:id="menuSellerHome"
                              alignment="CENTER_LEFT"
                              prefHeight="45.0"
                              visible="false"
                              managed="false"
                              onMouseClicked="#handleMenuClick"
                              style="-fx-background-radius: 8; -fx-cursor: hand;">
                            <children>
                                <Button text="🏪   Seller Home"
                                        mouseTransparent="true"
                                        prefWidth="220.0"
                                        style="-fx-background-color: transparent; -fx-text-fill: #f59e0b; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>

                        <HBox fx:id="menuManageAuctions"
                              alignment="CENTER_LEFT"
                              prefHeight="45.0"
                              visible="false"
                              managed="false"
                              onMouseClicked="#handleMenuClick"
                              style="-fx-background-radius: 8; -fx-cursor: hand;">
                            <children>
                                <Button text="📝   Quản lý phiên"
                                        mouseTransparent="true"
                                        prefWidth="220.0"
                                        style="-fx-background-color: transparent; -fx-text-fill: #4a5568; -fx-font-size: 16px;"/>
                            </children>
                        </HBox>

                        <HBox fx:id="menuBackToBidder"
                              alignment="CENTER_LEFT"
                              prefHeight="45.0"
                              visible="false"
                              managed="false"
                              onMouseClicked="#handleMenuClick"
                              style="-fx-background-radius: 8; -fx-cursor: hand;">
                            <children>
                                <Button text="↩   Trở về Bidder"
                                        mouseTransparent="true"
                                        prefWidth="220.0"
                                        style="-fx-background-color: transparent; -fx-text-fill: #2563eb; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>

                        <HBox fx:id="menuSettings"
                              alignment="CENTER_LEFT"
                              prefHeight="45.0"
                              onMouseClicked="#handleMenuClick"
                              style="-fx-background-radius: 8; -fx-cursor: hand;">
                            <children>
                                <Button text="⚙ Cài đặt"
                                        mouseTransparent="true"
                                        prefWidth="220.0"
                                        style="-fx-background-color: transparent; -fx-text-fill: #4a5568; -fx-font-size: 16px;"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- RIGHT SIDE -->
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <!-- HEADER -->
                        <HBox alignment="CENTER_LEFT"
                              prefHeight="80.0"
                              style="-fx-background-color: #ffffff; -fx-padding: 0 30 0 30; -fx-border-color: #f0f0f0; -fx-border-width: 0 0 1 0;">
                            <children>

                                <Label fx:id="titleLabel"
                                       text="Xin chào, Bidder"
                                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2e384d;"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <HBox alignment="CENTER"
                                      prefHeight="10.0"
                                      prefWidth="300.0"
                                      style="-fx-background-color: #f3f4f6; -fx-background-radius: 24; -fx-padding: 0 18 0 18;">
                                    <children>
                                        <Label text="🔍"
                                               textFill="#9ca3af"
                                               style="-fx-font-size: 14px;"/>

                                        <TextField fx:id="searchInput"
                                                   promptText="Tìm kiếm..."
                                                   HBox.hgrow="ALWAYS"
                                                   style="-fx-background-color: transparent; -fx-prompt-text-fill: #9ca3af; -fx-text-fill: #374151;"/>
                                    </children>
                                </HBox>

                                <Button fx:id="screenModeButton"
                                        text="🌙"
                                        style="-fx-background-color: transparent; -fx-font-size: 18px; -fx-cursor: hand;">
                                    <HBox.margin>
                                        <Insets left="16.0"/>
                                    </HBox.margin>
                                </Button>

                                <Button fx:id="avatarButton"
                                        text="👤"
                                        prefHeight="40.0"
                                        prefWidth="40.0"
                                        style="-fx-background-color: #e2e8f0; -fx-background-radius: 20; -fx-cursor: hand;">
                                    <HBox.margin>
                                        <Insets left="16.0"/>
                                    </HBox.margin>
                                </Button>
                            </children>
                        </HBox>

                        <!-- CONTENT AREA -->
                        <StackPane fx:id="contentArea"
                                   VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: #fcfcfc;"/>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>