<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="800.0" prefWidth="1300.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <left>
        <VBox prefWidth="260.0" spacing="5.0" style="-fx-background-color: #fafafa; -fx-border-color: #e5e7eb; -fx-border-width: 0 1 0 0; -fx-padding: 20 15;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 20 10;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="Bni" />
                        <Label text=" ⌄" textFill="#6b7280" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button style="-fx-background-color: transparent; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-cursor: hand;" text="+" />
                    </children>
                </HBox>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" text="🏠  Home" />

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" text="📢  Campaigns" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 13; -fx-cursor: hand;" text="       + New campaign">
                    <padding>
                        <Insets bottom="5.0" left="10.0" top="5.0" />
                    </padding></Button>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" text="💳  Transactions" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" text="👥  Contacts" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" text="✉️  Engage" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" text="🏦  Finance" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" text="⚙️  Settings" />

                <Separator style="-fx-padding: 15 0;" />

                <HBox alignment="CENTER_LEFT">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="5.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-size: 12; -fx-text-fill: #6b7280; -fx-font-weight: bold;" text="Givebutter Plus" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 12; -fx-text-fill: #4f46e5; -fx-cursor: hand;" text="↑ Upgrade" />
                    </children>
                </HBox>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: #eff6ff; -fx-text-fill: #2563eb; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="🔀  Workflows">
                    <padding>
                        <Insets bottom="10.0" left="10.0" top="10.0" />
                    </padding></Button>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" text="📊  Custom Reports" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" text="🧹  Data Hygiene" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #374151; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" text="✅  Tasks" />
            </children>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #ffffff; -fx-border-color: transparent;" BorderPane.alignment="CENTER">
            <content>
                <VBox style="-fx-background-color: #ffffff; -fx-padding: 80 60;">
                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="60.0">
                            <children>

                                <VBox maxWidth="550.0" spacing="25.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label style="-fx-font-weight: 900; -fx-font-size: 24;" text="Givebutter" />
                                                <Label style="-fx-background-color: #fef08a; -fx-text-fill: #854d0e; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 13; -fx-font-weight: bold;" text="Plus" />
                                            </children>
                                        </HBox>

                                        <Label style="-fx-font-size: 64; -fx-font-weight: 900;" text="Workflows" />

                                        <Label style="-fx-font-size: 18; -fx-text-fill: #4b5563; -fx-line-spacing: 7;" text="Simplify your communications and donor relations with Workflows! Automate reaching out to donors, tagging event attendees, sending cheerful birthday messages, and so much more!" wrapText="true" />

                                        <HBox spacing="15.0">
                                            <children>
                                                <Button style="-fx-background-color: transparent; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-padding: 12 24; -fx-font-size: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="Learn more" />
                                                <Button style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="Start your free trial" />
                                            </children>
                                            <VBox.margin>
                                                <Insets top="10.0" />
                                            </VBox.margin>
                                        </HBox>
                                    </children>
                                </VBox>

                                <StackPane prefHeight="380.0" prefWidth="500.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 24;" HBox.hgrow="ALWAYS">
                                    <children>
                                        <AnchorPane opacity="0.3" style="-fx-border-color: #d1d5db; -fx-border-width: 2; -fx-border-radius: 12;" StackPane.alignment="CENTER">
                                            <StackPane.margin>
                                                <Insets bottom="60.0" left="60.0" right="60.0" top="60.0" />
                                            </StackPane.margin>
                                        </AnchorPane>

                                        <VBox maxWidth="280.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15 20; -fx-border-color: #e5e7eb; -fx-border-radius: 12;" StackPane.alignment="TOP_LEFT">
                                            <effect>
                                                <DropShadow color="#0000001a" offsetX="0" offsetY="10" radius="20" spread="0.0" />
                                            </effect>
                                            <StackPane.margin>
                                                <Insets left="30.0" top="50.0" />
                                            </StackPane.margin>
                                            <children>
                                                <Label style="-fx-background-color: #fef08a; -fx-padding: 5 15; -fx-background-radius: 20; -fx-font-weight: bold; -fx-font-size: 14;" text="Add trigger">
                                                    <VBox.margin>
                                                        <Insets bottom="15.0" left="-5.0" top="-30.0" />
                                                    </VBox.margin>
                                                </Label>
                                                <Label style="-fx-font-size: 12; -fx-text-fill: #6b7280; -fx-font-weight: bold;" text="⚡ Donation made" />
                                                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 8 12; -fx-margin-top: 10;">
                                                    <children>
                                                        <Label style="-fx-font-weight: bold;" text="Greater than ⌄" />
                                                        <Separator orientation="VERTICAL" />
                                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #059669;" text="\$ 1,000" />
                                                    </children>
                                                    <VBox.margin>
                                                        <Insets top="10.0" />
                                                    </VBox.margin>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox maxWidth="280.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15 20; -fx-border-color: #e5e7eb; -fx-border-radius: 12;" StackPane.alignment="BOTTOM_RIGHT">
                                            <effect>
                                                <DropShadow color="#0000001a" offsetX="0" offsetY="10" radius="20" spread="0.0" />
                                            </effect>
                                            <StackPane.margin>
                                                <Insets bottom="50.0" right="30.0" />
                                            </StackPane.margin>
                                            <children>
                                                <Label style="-fx-font-size: 12; -fx-text-fill: #6b7280; -fx-font-weight: bold;" text="🏷️ Tag contact" />
                                                <HBox spacing="10.0">
                                                    <children>
                                                        <Label style="-fx-background-color: #e0e7ff; -fx-text-fill: #3730a3; -fx-padding: 6 12; -fx-background-radius: 6; -fx-font-weight: bold;" text="# Recent" />
                                                        <Label style="-fx-background-color: #dcfce7; -fx-text-fill: #166534; -fx-padding: 6 12; -fx-background-radius: 6; -fx-font-weight: bold;" text="# High Value" />
                                                    </children>
                                                    <VBox.margin>
                                                        <Insets top="10.0" />
                                                    </VBox.margin>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </StackPane>

                            </children>
                        </HBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

    </center>
</BorderPane>