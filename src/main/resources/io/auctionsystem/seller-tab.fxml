<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="900.0" prefWidth="1440.0" styleClass="root-pane" stylesheets="@css/seller-tab.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.auctionsystem.controllers.SellerTabController">

    <top>
        <HBox alignment="CENTER_LEFT" minHeight="76.0" prefHeight="76.0" styleClass="header">
            <padding>
                <Insets bottom="0" left="24" right="24" top="0" />
            </padding>

            <Label styleClass="logo-text" text="AUCTION SYSTEM" />

            <Region HBox.hgrow="ALWAYS" />

            <TextField prefWidth="320.0" promptText="Tìm sản phẩm, phiên đấu giá..." styleClass="header-search" />

            <Label styleClass="header-icon" text="🔔" />
            <Label styleClass="header-icon" text="💬" />

            <HBox alignment="CENTER" spacing="10" styleClass="user-box">
                <Label styleClass="avatar-icon" text="👤" />
                <VBox spacing="2">
                    <Label styleClass="user-name" text="Người bán" />
                    <Label styleClass="user-email" text="seller01@example.com" />
                </VBox>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox maxWidth="280.0" minWidth="200.0" prefWidth="240.0" spacing="14.0" styleClass="sidebar">
            <padding>
                <Insets bottom="22" left="16" right="16" top="22" />
            </padding>

            <VBox spacing="6">
                <Label styleClass="sidebar-heading" text="TRUNG TÂM NGƯỜI BÁN" />
                <Label styleClass="sidebar-subheading" text="Quản lý sản phẩm và phiên đấu giá" />
            </VBox>

            <Separator />

            <Button maxWidth="Infinity" styleClass="menu-button" text="🏠  Tổng quan" />
            <Button maxWidth="Infinity" styleClass="menu-button active-menu-button" text="📦  Sản phẩm của tôi" />
            <Button maxWidth="Infinity" styleClass="menu-button" text="🔨  Phiên đấu giá" />
            <Button maxWidth="Infinity" styleClass="menu-button" text="📝  Tạo sản phẩm mới" />
            <Button maxWidth="Infinity" styleClass="menu-button" text="📊  Báo cáo" />
            <Button maxWidth="Infinity" styleClass="menu-button" text="⚙  Cài đặt" />

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="8" styleClass="support-box">
                <Label styleClass="support-title" text="Hỗ trợ nhanh" />
                <Label styleClass="support-text" text="Cập nhật trạng thái phiên đấu giá, sản phẩm và đơn hàng tại đây." wrapText="true" />
            </VBox>

            <Button maxWidth="Infinity" styleClass="logout-button" text="🚪  Đăng xuất" />
        </VBox>
    </left>

    <center>
        <VBox fillWidth="true" spacing="18.0" styleClass="content-area">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4">
                    <Label styleClass="page-title" text="Quản lý sản phẩm đấu giá" />
                    <Label styleClass="page-subtitle" text="Theo dõi sản phẩm, ảnh, mô tả và trạng thái đấu giá" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button styleClass="primary-button" text="+ Thêm sản phẩm" />
            </HBox>

            <HBox spacing="18" VBox.vgrow="ALWAYS">

                <VBox spacing="12" styleClass="panel-box" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="section-title" text="Danh sách sản phẩm" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField promptText="Tìm theo tên..." styleClass="filter-field" />
                        <Button styleClass="secondary-button" text="Lọc" />
                    </HBox>

                    <TableView styleClass="product-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn prefWidth="90.0" text="Mã SP" />
                            <TableColumn prefWidth="220.0" text="Tên sản phẩm" />
                            <TableColumn prefWidth="140.0" text="Danh mục" />
                            <TableColumn prefWidth="140.0" text="Giá khởi điểm" />
                            <TableColumn prefWidth="120.0" text="Trạng thái" />
                            <TableColumn prefWidth="170.0" text="Kết thúc" />
                        </columns>
                    </TableView>
                </VBox>

                <VBox maxWidth="420.0" minWidth="300.0" prefWidth="360.0" spacing="16" styleClass="detail-panel">

                    <Label styleClass="section-title" text="Chi tiết sản phẩm" />

                    <StackPane prefHeight="220.0" styleClass="image-frame">
                        <ImageView fitHeight="200.0" fitWidth="300.0" preserveRatio="true">
                            <image>
                            </image>
                        </ImageView>
                    </StackPane>

                    <VBox spacing="10" styleClass="info-card">
                        <Label styleClass="product-name" text="Tranh sơn dầu cổ điển" />
                        <Label styleClass="product-meta" text="Mã: SP001" />
                        <Label styleClass="product-meta" text="Danh mục: Nghệ thuật" />
                        <Label styleClass="product-price" text="Giá khởi điểm: 15.000.000 VNĐ" />
                        <Label styleClass="status-open" text="Trạng thái: Đang mở đấu giá" />
                    </VBox>

                    <VBox spacing="8" styleClass="info-card">
                        <Label styleClass="mini-title" text="Mô tả sản phẩm" />
                        <TextArea editable="false" prefRowCount="6" styleClass="description-area" text="Tác phẩm được bảo quản tốt, khung gỗ chắc chắn, phù hợp cho nhà sưu tầm hoặc không gian trưng bày cao cấp." wrapText="true" />
                    </VBox>

                    <HBox spacing="10">
                        <Button maxWidth="Infinity" styleClass="secondary-button" text="Chỉnh sửa" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" styleClass="primary-button" text="Mở phiên đấu giá" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>
            </HBox>

            <HBox spacing="16">
                <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="summary-number" text="12" />
                    <Label styleClass="summary-label" text="Phiên đang hoạt động" />
                </VBox>

                <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="summary-number" text="45" />
                    <Label styleClass="summary-label" text="Tổng sản phẩm" />
                </VBox>

                <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="summary-number" text="8" />
                    <Label styleClass="summary-label" text="Chờ duyệt" />
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
