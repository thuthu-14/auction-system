<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="rootPane" prefHeight="900.0" prefWidth="1440.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.auctionsystem.HomeController">
   <children>

      <HBox prefHeight="900.0" prefWidth="1440.0" style="-fx-background-color: #ffffff;">
         <children>
            <VBox prefHeight="900.0" prefWidth="215.0" spacing="5.0" style="-fx-background-color: #ffffff; -fx-border-color: #f0f0f0; -fx-border-width: 0 1 0 0; -fx-padding: 20 15 20 15;">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="10.0">
                     <children>
                        <StackPane prefHeight="150.0" prefWidth="200.0" style="-fx-translate-y: -5; -fx-translate-x: -5;">
                           <children>
                              <ImageView fitHeight="56.0" fitWidth="59.0" pickOnBounds="true" preserveRatio="true" style="-fx-translate-x: -58;">
                                 <image>
                                    <Image url="@../../CSS/logo.png" />
                                 </image>
                              </ImageView>
                              <Label alignment="CENTER_RIGHT" prefHeight="40.0" prefWidth="170.0" style="-fx-font-size: 25;" styleClass="my-darley" stylesheets="@../../CSS/style.css" text="BubblyBid" textFill="#2e384d">
                                 <font>
                                    <Font name="System Bold" size="25.0" />
                                 </font>
                              </Label>
                           </children>
                        </StackPane>
                     </children>
                     <VBox.margin>
                        <Insets bottom="25.0" left="10.0" />
                     </VBox.margin>
                  </HBox>

                  <HBox fx:id="menuHome" alignment="CENTER_LEFT" onMouseClicked="#handleMenuClick" prefHeight="45.0" style="-fx-background-radius: 8; -fx-cursor: hand;">
                     <children>
                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mouseTransparent="true" prefWidth="230.0" style="-fx-background-color: transparent;" styleClass="font-mulish" stylesheets="@../../CSS/style.css" text="🏠   Trang chủ" textFill="#4a5568">
                           <font>
                              <Font size="17.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>

                  <HBox fx:id="menuAI" alignment="CENTER_LEFT" onMouseClicked="#handleMenuClick" prefHeight="45.0" style="-fx-background-radius: 8; -fx-cursor: hand;">
                     <children>
                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mouseTransparent="true" prefWidth="230.0" style="-fx-background-color: transparent;" text="☁️ Ask Bubbly AI" textFill="#4a5568">
                           <font><Font size="14.0" /></font>
                        </Button>
                     </children>
                  </HBox>

                  <Label text="BIDDING" textFill="#a0aec0">
                     <font><Font name="System Bold" size="11.0" /></font>
                     <VBox.margin>
                        <Insets bottom="5.0" left="15.0" top="20.0" />
                     </VBox.margin>
                  </Label>

                  <HBox fx:id="menuFlash" alignment="CENTER_LEFT" onMouseClicked="#handleMenuClick" prefHeight="45.0" style="-fx-background-radius: 8; -fx-cursor: hand;">
                     <children>
                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mouseTransparent="true" prefWidth="230.0" style="-fx-background-color: transparent;" text=" ⚡     Flash Bid" textFill="#4a5568">
                           <font><Font size="17.0" /></font>
                        </Button>
                     </children>
                  </HBox>

                  <HBox fx:id="menuRecent" alignment="CENTER_LEFT" onMouseClicked="#handleMenuClick" prefHeight="45.0" style="-fx-background-radius: 8; -fx-cursor: hand;">
                     <children>
                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mouseTransparent="true" prefWidth="230.0" style="-fx-background-color: transparent;" text="📈   Lịch sử giao dịch" textFill="#4a5568">
                           <font><Font size="16.0" /></font>
                        </Button>
                     </children>
                  </HBox>

                  <HBox fx:id="menuMsg" alignment="CENTER_LEFT" onMouseClicked="#handleMenuClick" prefHeight="45.0" style="-fx-background-radius: 8; -fx-cursor: hand;">
                     <children>
                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mouseTransparent="true" prefHeight="40.0" prefWidth="182.0" style="-fx-background-color: transparent; -fx-translate-x: -5;" text="📨   Tin nhắn" textFill="#4a5568">
                           <font><Font size="18.0" /></font>
                        </Button>
                     </children>
                  </HBox>

                  <HBox fx:id="menuPay" alignment="CENTER_LEFT" onMouseClicked="#handleMenuClick" prefHeight="45.0" style="-fx-background-radius: 8; -fx-cursor: hand;">
                     <children>
                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mouseTransparent="true" prefWidth="230.0" style="-fx-background-color: transparent;" text="💳   Nạp tiền" textFill="#4a5568">
                           <font><Font size="17.0" /></font>
                        </Button>
                     </children>
                  </HBox>

                  <Region VBox.vgrow="ALWAYS" />

                  <HBox fx:id="menuUpgrade" alignment="CENTER_LEFT" onMouseClicked="#handleMenuClick" prefHeight="45.0" style="-fx-background-radius: 8; -fx-cursor: hand;">
                     <children>
                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mouseTransparent="true" prefWidth="230.0" style="-fx-background-color: transparent;" text="👨‍🏫 Trở thành Người bán" textFill="#e53e3e">
                           <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                     </children>
                  </HBox>

                  <HBox fx:id="menuSettings" alignment="CENTER_LEFT" onMouseClicked="#handleMenuClick" prefHeight="45.0" style="-fx-background-radius: 8; -fx-cursor: hand;">
                     <children>
                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mouseTransparent="true" prefWidth="230.0" style="-fx-background-color: transparent;" text="⚙   Cài Đặt" textFill="#4a5568">
                           <font><Font size="17.0" /></font>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: #ffffff; -fx-padding: 0 40 0 40; -fx-border-color: #f0f0f0; -fx-border-width: 0 0 1 0;">
                     <children>
                        <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" onMouseClicked="#openSearchOverlay" prefHeight="45.0" prefWidth="350.0" style="-fx-background-color: #f4f6f8; -fx-background-radius: 12; -fx-padding: 0 15 0 15; -fx-cursor: hand;">
                           <children>
                              <Label text="🔍" textFill="#a0aec0" />
                              <Label text="Tìm kiếm sản phẩm..." textFill="#a0aec0" HBox.hgrow="ALWAYS">
                                 <font><Font size="14.0" /></font>
                                 <padding><Insets left="10.0" right="130.0" /></padding>
                              </Label>
                           </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button style="-fx-background-color: transparent; -fx-cursor: hand;" text="🌙">
                           <font><Font size="20.0" /></font>
                        </Button>
                        <Button prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #e2e8f0; -fx-background-radius: 20; -fx-cursor: hand;" text="👤">
                           <font><Font size="14.0" /></font>
                           <HBox.margin>
                              <Insets left="20.0" />
                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>

                  <StackPane fx:id="contentArea" style="-fx-background-color: #fcfcfc;" VBox.vgrow="ALWAYS">
                     <children>
                        <VBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Label text="Welcome to BubblyBid Dashboard" textFill="#2e384d">
                                 <font><Font name="System Bold" size="28.0" /></font>
                              </Label>
                              <Label text="Select a menu item from the left to get started" textFill="#a0aec0">
                                 <font><Font size="16.0" /></font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
               </children>

            </VBox>
         </children>
      </HBox>

      <StackPane fx:id="searchOverlay" visible="false">
         <children>
            <Region onMouseClicked="#closeSearchOverlay" style="-fx-background-color: rgba(0, 0, 0, 0.4);" />

            <VBox maxHeight="500.0" maxWidth="650.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 30, 0, 0, 10);">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" style="-fx-padding: 0 20; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
                     <children>
                        <Label text="🔍">
                           <font><Font size="20.0" /></font>
                        </Label>
                        <TextField fx:id="searchInput" prefHeight="40.0" promptText="Tìm kiếm sản phẩm, danh mục..." style="-fx-background-color: transparent; -fx-font-size: 16;" HBox.hgrow="ALWAYS" />
                        <Label onMouseClicked="#closeSearchOverlay" style="-fx-cursor: hand; -fx-background-color: #f3f4f6; -fx-padding: 4 8; -fx-background-radius: 6; -fx-font-size: 12;" text="ESC" />
                     </children>
                  </HBox>

                  <HBox spacing="10.0" style="-fx-padding: 15 20;">
                     <children>
                        <ToggleButton selected="true" style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 6 15; -fx-cursor: hand; -fx-base: #e0e7ff; -fx-text-fill: #3730a3; -fx-font-weight: bold;" text="Tất cả">
                           <toggleGroup>
                              <ToggleGroup fx:id="categoryFilter" />
                           </toggleGroup>
                        </ToggleButton>
                        <ToggleButton style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 6 15; -fx-cursor: hand; -fx-background-color: #f3f4f6;" text="💎 Trang sức" toggleGroup="$categoryFilter" />
                        <ToggleButton style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 6 15; -fx-cursor: hand; -fx-background-color: #f3f4f6;" text="💄 Mỹ phẩm" toggleGroup="$categoryFilter" />
                        <ToggleButton style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 6 15; -fx-cursor: hand; -fx-background-color: #f3f4f6;" text="👗 Thời trang" toggleGroup="$categoryFilter" />
                        <ToggleButton style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 6 15; -fx-cursor: hand; -fx-background-color: #f3f4f6;" text="📦 Khác" toggleGroup="$categoryFilter" />
                     </children>
                  </HBox>

                  <VBox alignment="CENTER" prefHeight="300.0" spacing="10.0" style="-fx-background-color: #f9fafb; -fx-background-radius: 0 0 16 16;" VBox.vgrow="ALWAYS">
                     <children>
                        <Label text="🔍" textFill="#d1d5db">
                           <font><Font size="40.0" /></font>
                        </Label>
                        <Label text="Nhập từ khóa để bắt đầu tìm kiếm" textFill="#6b7280" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </StackPane>

   </children>
</StackPane>
