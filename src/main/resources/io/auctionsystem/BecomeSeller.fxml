<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="800.0" prefWidth="1000.0"
      style="-fx-background-color: #fcfcfc; -fx-padding: 50;"
      stylesheets="@css/style.css, @css/Home.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.auctionsystem.controllers.BecomeSellerController">

    <children>
        <Label alignment="CENTER"
               maxWidth="Infinity"
               text="Đăng ký Trở thành Người bán"
               textFill="#6b7280">
            <font>
                <Font name="System Bold" size="30.0" />
            </font>
            <VBox.margin>
                <Insets bottom="40.0" />
            </VBox.margin>
        </Label>

        <GridPane hgap="50.0" vgap="30.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <children>
                <VBox spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <children>
                        <Label text="Họ và tên" textFill="#111827">
                            <font>
                                <Font name="System Bold" size="17.0" />
                            </font>
                        </Label>
                        <TextField fx:id="nameField" prefHeight="50.0" promptText="Nhập tên của bạn"
                                   style="-fx-background-color: #e5e7eb; -fx-background-radius: 12; -fx-text-fill: #374151; -fx-padding: 0 20; -fx-font-size: 14" />
                    </children>
                </VBox>

                <VBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <children>
                        <Label text="Email" textFill="#111827">
                            <font>
                                <Font name="System Bold" size="17.0" />
                            </font>
                        </Label>
                        <TextField fx:id="emailField" prefHeight="50.0" promptText="Nhập email của bạn"
                                   style="-fx-background-color: #e5e7eb; -fx-background-radius: 12; -fx-text-fill: #374151; -fx-padding: 0 20; -fx-font-size: 14" />
                    </children>
                </VBox>

                <VBox spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <children>
                        <Label text="Số điện thoại" textFill="#111827">
                            <font>
                                <Font name="System Bold" size="17.0" />
                            </font>
                        </Label>
                        <TextField fx:id="phoneField" prefHeight="50.0" promptText="Nhập số điện thoại của bạn"
                                   style="-fx-background-color: #e5e7eb; -fx-background-radius: 12; -fx-text-fill: #374151; -fx-padding: 0 20; -fx-font-size: 14" />
                    </children>
                </VBox>

                <VBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                        <Label text="Địa chỉ" textFill="#111827">
                            <font>
                                <Font name="System Bold" size="17.0" />
                            </font>
                        </Label>
                        <TextField fx:id="addressField" prefHeight="50.0" promptText="Nhập địa chỉ của bạn"
                                   style="-fx-background-color: #e5e7eb; -fx-background-radius: 12; -fx-text-fill: #374151; -fx-padding: 0 20; -fx-font-size: 14" />
                    </children>
                </VBox>

                <VBox spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <children>
                        <Label text="Mật khẩu" textFill="#111827">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <StackPane alignment="CENTER_RIGHT">
                            <children>
                                <PasswordField fx:id="passwordField" prefHeight="50.0" promptText="Nhập mật khẩu"
                                               style="-fx-background-color: #e5e7eb; -fx-background-radius: 12; -fx-padding: 0 45 0 20; -fx-font-size: 14" />

                                <TextField fx:id="passwordTextField" managed="false" visible="false" prefHeight="50.0"
                                           style="-fx-background-color: #e5e7eb; -fx-background-radius: 12; -fx-padding: 0 45 0 20;" />

                                <Button fx:id="btnTogglePassword" onAction="#togglePasswordVisibility"
                                        style="-fx-background-color: transparent; -fx-cursor: hand;" text="👁">
                                    <StackPane.margin>
                                        <Insets right="10.0" />
                                    </StackPane.margin>
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Button>
                            </children>
                        </StackPane>
                    </children>
                </VBox>
            </children>
        </GridPane>

        <Region VBox.vgrow="ALWAYS" />

        <HBox alignment="BOTTOM_RIGHT" spacing="20.0">
            <children>
                <Button fx:id="btnCancel"
                        onAction="#handleCancel"
                        prefHeight="45.0"
                        prefWidth="120.0"
                        text="Quay lại"
                        styleClass="form-button">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>

                <Button fx:id="btnSave"
                        onAction="#handleSave"
                        prefHeight="45.0"
                        prefWidth="120.0"
                        text="Lưu"
                        styleClass="form-button">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>