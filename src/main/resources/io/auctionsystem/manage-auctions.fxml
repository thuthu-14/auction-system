<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.auctionsystem.controllers.ManageAuctionsController"
      spacing="15"
      style="-fx-background-color: #f6f7fb;">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <Label text="📝 TẠO VÀ QUẢN LÝ PHIÊN"
           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2e384d;"/>

    <HBox spacing="10">
        <Button text="📝 TẠO PHIÊN MỚI"
                onAction="#handleCreateAuction"
                style="-fx-background-color: #2b6cb0; -fx-text-fill: white; -fx-background-radius: 8;"/>
        <Button text="❌ XÓA PHIÊN"
                onAction="#handleDeleteAuction"
                style="-fx-background-color: #e53e3e; -fx-text-fill: white; -fx-background-radius: 8;"/>
        <Button text="👁 XEM BID HISTORY"
                onAction="#handleViewHistory"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄 REFRESH"
                onAction="#handleRefresh"/>
    </HBox>

    <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Item Name" prefWidth="180"/>
            <TableColumn text="Category" prefWidth="130"/>
            <TableColumn text="Starting Price" prefWidth="130"/>
            <TableColumn text="Current Price" prefWidth="130"/>
            <TableColumn text="Highest Bidder" prefWidth="160"/>
            <TableColumn text="Status" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>